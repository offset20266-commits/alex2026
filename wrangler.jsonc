{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alex2026",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "33ed8105-e6ae-460a-8af8-dbffb97e9d01","database_name": "alex2026" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "980b5b45a412456e909c12f65040ab5a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
